# =============================================================================
# CIP Code Intelligence Platform — .gitignore
# =============================================================================

# --- CIP Runtime & Index Data (Repo-Specific) ---
.cip/

# --- Python & Test Caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
snapshot_report.html

# --- Node / Web Console ---
web/node_modules/
web/dist/
web/.vite/
web/*.tsbuildinfo
*.tsbuildinfo

# --- IDE & OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Build Artifacts ---
dist/
build/
*.egg-info/

# --- Sync System Backups ---
sync_global/backups/
